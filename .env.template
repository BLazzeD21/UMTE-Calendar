TELEGRAM_BOT_TOKEN=8238251610:AAEF9F9v7f12RtGXu12RtGXuX-R4YxyPBzA

# Replacement for https://api.telegram.org — a mirror of the Bot API hosted where
# Telegram is not blocked (see the Cloudflare Worker in cloudflare/).
TELEGRAM_API_ROOT=https://umte-telegram-mirror.example.workers.dev

# Telegram user id allowed to run the admin commands /test and /send.
# Leave it empty and the bot has no admin: both commands stay unavailable.
TELEGRAM_ADMIN_ID=123456789

# Optional SOCKS5 proxy for the bot. An alternative to TELEGRAM_API_ROOT, not a
# companion — leave it empty when the mirror is used.
PROXY_URL=

# Domain the .ics files are served from. Notification links are built as
# <CALENDAR_BASE_URL>/<group id>.ics — omit it to send messages without the link.
CALENDAR_BASE_URL=https://umeos.example.tech

# Docker deployment only. DOMAIN is the host Caddy issues the certificate for —
# it must resolve to this server. Keep it in sync with CALENDAR_BASE_URL.
DOMAIN=umeos.example.tech

# Timezone of the container. Events are built in local time and the calendar
# declares Europe/Moscow, so anything else shifts every event.
TZ=Europe/Moscow

# Fallback for a single group, used only when groups.json is absent.
# Prefer groups.json — see groups.template.json.
